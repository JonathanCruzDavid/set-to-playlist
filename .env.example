# Copy this file to .env and fill in the values (see README.md for where to get them).

# --- YouTube (optional) -----------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> API key
# (with "YouTube Data API v3" enabled). Leave blank to use yt-dlp instead.
YOUTUBE_API_KEY=

# --- Spotify (required) -----------------------------------------------------
# https://developer.spotify.com/dashboard -> your app -> Settings
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
# Must match a Redirect URI added in your Spotify app settings EXACTLY.
# Spotify doesn't accept "localhost"; use the loopback IP 127.0.0.1.
# The web UI is served on this host/port too.
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- Web app ----------------------------------------------------------------
# Random string that signs the session cookie. Generate one with:
#   py -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# --- Optional ---------------------------------------------------------------
# Where the CLI caches your Spotify token (default: ./.spotify_cache)
# SPOTIFY_CACHE_PATH=
# Where unmatched-track reports are written (default: ./unmatched)
# UNMATCHED_DIR=
